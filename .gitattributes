# Normalize line endings across OS
* text=auto eol=lf

# Source and text files
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.blade.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.htaccess text eol=lf
*.ini text eol=lf
*.dist text eol=lf
*.lock text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svgz binary
*.bmp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.rar binary
*.7z binary
*.phar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mo binary
*.sqlite binary
*.db binary
